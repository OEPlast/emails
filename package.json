{
  "name": "@rawura/emails",
  "version": "1.1.0",
  "private": true,
  "description": "Shared transactional email templates, rendering engine and payload types for the Rawura platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OEPlast/emails.git"
  },
  "license": "UNLICENSED",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.js",
    "prepare": "npm run build",
    "preview": "npm run build && node dist/scripts/preview.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
