{{!--
  Money breakdown.
  Usage: {{> payment-summary payment=payment}}

  Tax and discount rows appear only when non-zero — the old template always printed a
  "Tax ₦0.00" line, and printed "Subtotal" as the grand total while calling the line-item
  total "Total Shopping", which read as though the customer was being charged twice.
--}}
<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  {{> kv label="Items" value=(currency payment.totalShopping)}}
  {{> kv label="Shipping" value=(currency payment.shipping)}}
  {{#if (gt payment.tax 0)}}{{> kv label="Tax" value=(currency payment.tax)}}{{/if}}
  {{#if (gt payment.discount 0)}}{{> kv label="Discount" value=(concat "-" (currency payment.discount)) accent=true}}{{/if}}
</table>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:6px;">
  <tr><td class="rule" style="height:1px; line-height:1px; font-size:0; background-color:#e4e7ec;">&zwj;</td></tr>
  <tr>
    <td style="padding-top:14px;">
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
        <tr>
          <td style="font-size:16px; font-weight:700; color:#1B1B1B;">Total paid</td>
          <td align="right" class="strong-figure" style="font-size:20px; line-height:28px; font-weight:700; color:#1B1B1B;">{{currency payment.subtotal}}</td>
        </tr>
      </table>
      {{#if payment.method}}
      <p class="small" style="margin:8px 0 0 0; font-size:12px; line-height:18px; color:#667085;">Paid with {{payment.method}}{{#if payment.reference}} &middot; ref {{payment.reference}}{{/if}}</p>
      {{/if}}
    </td>
  </tr>
</table>
