{{!--
  The shell every email renders inside: head, logo, the template's body, footer.

  Usage:  {{#> layout title="Order confirmed"}} …body… {{/layout}}

  Deliberately plain: one white column, no panels, no web fonts. Text styles are set once on
  the content cell and inherited, so a template only writes <h1>, <p> and <strong>. The <style>
  block is a refinement; clients that strip it still get readable, correctly coloured text from
  the inline styles.

  Dark mode: `.ink` / `.muted` / `.rule` / `.bg` are the only things recoloured. Any element
  with an inline near-black colour must carry `.ink` (scripts/preview.ts checks this).
--}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{title}}</title>
  <style>
    body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    img { border: 0; outline: none; line-height: 100%; }
    h1 { margin: 0 0 12px 0; font-size: 22px; line-height: 30px; font-weight: 700; }
    p { margin: 0 0 14px 0; }
    a { color: #6f9420; }
    @media (prefers-color-scheme: dark) {
      .bg { background-color: #111315 !important; }
      .ink, h1, strong { color: #e8eaed !important; }
      .muted { color: #a1a5ab !important; }
      .rule { border-color: #2f353b !important; }
      a { color: #a9cf5c !important; }
      a.btn { color: #ffffff !important; }
    }
  </style>
</head>
<body class="bg" style="margin:0; padding:0; background-color:#ffffff;">
  {{!-- Inbox preview text; the trailing entities stop clients pulling body copy in after it. --}}
  <div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px;">
    {{preheader}}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
  </div>

  <table class="bg" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%; max-width:560px;">
          <tr>
            <td style="padding:0 0 28px 0;">
              <a href="{{links.storefront}}" style="text-decoration:none;">
                {{#if brand.logoUrl}}
                <img src="{{emailImage brand.logoUrl}}" alt="{{brand.storeName}}" width="140" style="display:block; width:140px; max-width:140px; height:auto;">
                {{else}}
                <span class="ink" style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:20px; font-weight:700; color:#1B1B1B;">{{brand.storeName}}</span>
                {{/if}}
              </a>
            </td>
          </tr>

          <tr>
            <td class="ink" style="font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:24px; color:#1B1B1B;">
{{> @partial-block}}
            </td>
          </tr>

          <tr>
            <td class="muted rule" style="padding:20px 0 0 0; border-top:1px solid #e5e7eb; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:19px; color:#6b7280;">
              Questions? <a href="mailto:{{brand.supportEmail}}" style="color:#6f9420;">{{brand.supportEmail}}</a>{{#if brand.supportPhone}} &middot; {{brand.supportPhone}}{{/if}}<br>
              {{brand.companyName}}{{#if brand.addressLine}}, {{brand.addressLine}}{{/if}} &middot; &copy; {{brand.year}}
              {{#if isMarketing}}
              <br><a href="{{links.preferences}}" style="color:#6b7280;">Email preferences</a>{{#if links.unsubscribe}} &middot; <a href="{{links.unsubscribe}}" style="color:#6b7280;">Unsubscribe</a>{{/if}}
              {{/if}}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
