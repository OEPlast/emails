{{!--
  The email's one call to action.
  Usage: {{> button href=orderStatusLink label="View your order"}}

  A background-coloured table cell around a padded link renders as a button in Outlook too,
  without a VML fallback.
--}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:6px 0 22px 0;">
  <tr>
    <td bgcolor="#6f9420" style="border-radius:8px; background-color:#6f9420;">
      <a class="btn" href="{{href}}" style="display:inline-block; padding:12px 22px; border-radius:8px; font-size:15px; line-height:20px; font-weight:600; color:#ffffff; text-decoration:none;">{{label}}</a>
    </td>
  </tr>
</table>
