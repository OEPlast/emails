{{!--
  Primary call-to-action.
  Usage: {{> button href=orderStatusLink label="View your order"}}

  The VML branch gives Outlook on Windows a real rounded button; the original templates used
  a bare padded <a>, which Outlook renders as plain underlined text.
--}}
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin: 8px 0 4px 0;">
  <tr>
    <td>
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{href}}" style="height:48px;v-text-anchor:middle;width:100%;" arcsize="21%" stroke="f" fillcolor="#6f9420">
        <w:anchorlock/>
        <center style="color:#ffffff;font-family:Segoe UI,Arial,sans-serif;font-size:16px;font-weight:600;">{{label}}</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-- -->
      <a class="btn" href="{{href}}" style="display:block; border-radius:10px; background-color:#6f9420; padding:14px 20px; text-align:center; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none;">{{label}}</a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
