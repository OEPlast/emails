{{!--
  One-time code panel.
  Usage: {{> otp code=otpCode expiresInMinutes=expiresInMinutes}}

  `expiresInMinutes` was already being passed to the verification email and rendered nowhere,
  so customers had no idea their code was on a clock.
--}}
<table class="panel-accent" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f4f8ea; border:1px solid #dbe8bd; border-radius:12px; margin:8px 0 16px 0;">
  <tr>
    <td align="center" style="padding:24px 16px;">
      <p class="small" style="margin:0 0 8px 0; font-size:13px; line-height:18px; color:#667085; text-transform:uppercase; letter-spacing:1px;">Your code</p>
      <div class="code" style="font-family:'SF Mono',Consolas,Menlo,monospace; font-size:32px; line-height:40px; font-weight:700; letter-spacing:8px; color:#1B1B1B;">{{code}}</div>
      {{#if expiresInMinutes}}
      <p class="small" style="margin:10px 0 0 0; font-size:13px; line-height:18px; color:#667085;">Expires in {{expiresInMinutes}} minutes</p>
      {{/if}}
    </td>
  </tr>
</table>
