{{!--
  Product table. One implementation for every email that lists items.

  Usage: {{> product-list items=products}}
         {{> product-list items=returnedProducts showPrice=false}}
         {{> product-list items=products showReviewLink=true}}

  The six original templates each had their own hand-rolled version of this row: some showed
  quantity, some price, some subtotal, some nothing but a name — for the same order. Fields
  now appear whenever the data carries them, so a single order reads consistently from
  confirmation through delivery.
--}}
<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  {{#each items}}
  <tr>
    <td style="padding:12px 0; border-bottom:1px solid #e4e7ec;">
      <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
        <tr>
          <td width="56" style="width:56px; padding-right:14px; vertical-align:top;">
            {{#if imagePath}}
            <img src="{{cdnUrl imagePath}}" alt="{{name}}" width="56" height="56" style="display:block; width:56px; height:56px; border-radius:8px; object-fit:cover; background-color:#f2f4f7;">
            {{else}}
            {{!-- Explicit placeholder: an <img> with an empty src renders as a broken-image icon. --}}
            <div style="width:56px; height:56px; border-radius:8px; background-color:#f2f4f7;">&nbsp;</div>
            {{/if}}
          </td>
          <td style="vertical-align:top;">
            {{#if category}}
            <p class="small" style="margin:0 0 3px 0; font-size:12px; line-height:16px; font-weight:500; color:#667085;">{{category}}</p>
            {{/if}}
            <h3 style="margin:0 0 3px 0; font-size:14px; line-height:20px; font-weight:600; color:#1B1B1B;">{{name}}</h3>
            {{#if attributes.length}}
            <p class="small" style="margin:0 0 3px 0; font-size:12px; line-height:16px; color:#667085;">{{#each attributes}}{{this.name}}: {{this.value}}{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
            {{/if}}
            {{#if quantity}}
            <p class="small" style="margin:0 0 3px 0; font-size:12px; line-height:16px; color:#667085;">Qty: {{quantity}}</p>
            {{/if}}
            {{#unless ../hidePrice}}
              {{#if discountPrice}}
              <p style="margin:0; font-size:14px; line-height:20px;">
                <span style="color:#98a2b3; text-decoration:line-through; margin-right:6px;">{{currency price}}</span>
                <span class="ink" style="font-weight:700; color:#1B1B1B;">{{currency discountPrice}}</span>
              </p>
              {{else if price}}
              <p class="ink" style="margin:0; font-size:14px; line-height:20px; font-weight:700; color:#1B1B1B;">{{currency price}}</p>
              {{/if}}
            {{/unless}}
            {{#if ../showReviewLink}}
              {{#if reviewLink}}
              <p style="margin:6px 0 0 0; font-size:13px; line-height:18px;"><a href="{{reviewLink}}" style="color:#6f9420; font-weight:600; text-decoration:none;">Write a review &rarr;</a></p>
              {{/if}}
            {{/if}}
          </td>
          {{#unless ../hidePrice}}
          {{#if subtotal}}
          <td align="right" class="ink" style="vertical-align:top; padding-left:10px; white-space:nowrap; font-size:14px; line-height:20px; font-weight:700; color:#1B1B1B;">
            {{currency subtotal}}
          </td>
          {{/if}}
          {{/unless}}
        </tr>
      </table>
    </td>
  </tr>
  {{/each}}
</table>
